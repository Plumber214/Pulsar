<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- Optional permissions requested contextually only if user enables Floating HUD -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".PulsarApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulsar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.Pulsar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home Screen Widgets (Jetpack Glance) -->
        <receiver
            android:name=".widget.PulsarCpuDialWidgetReceiver"
            android:label="@string/widget_cpu_dial_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulsar_cpu_dial_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PulsarTempDialWidgetReceiver"
            android:label="@string/widget_temp_dial_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulsar_temp_dial_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PulsarBatteryDialWidgetReceiver"
            android:label="@string/widget_battery_dial_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulsar_battery_dial_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PulsarRamDialWidgetReceiver"
            android:label="@string/widget_ram_dial_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulsar_ram_dial_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PulsarDualDialWidgetReceiver"
            android:label="@string/widget_dual_dial_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulsar_dual_dial_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PulsarMiniGaugeWidgetReceiver"
            android:label="Pulsar Gauge (Legacy)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulsar_mini_gauge_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PulsarSystemBarWidgetReceiver"
            android:label="@string/widget_system_bar_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulsar_system_bar_widget_info" />
        </receiver>

        <!-- Quick Settings Tile -->
        <service
            android:name=".service.PulsarQuickSettingsTileService"
            android:icon="@mipmap/ic_launcher"
            android:label="Pulsar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Background Telemetry Monitor Service -->
        <service
            android:name=".service.PulsarMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live on-device hardware telemetry monitoring" />
        </service>

        <!-- Floating Telemetry HUD Overlay Service -->
        <service
            android:name=".service.hud.PulsarHudService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Interactive floating telemetry performance overlay" />
        </service>
    </application>

</manifest>
